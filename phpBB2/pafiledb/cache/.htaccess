Options -Indexes -ExecCGI -Includes

# PA FileDB writes PHP cache payloads here. They are application-internal and
# must never be requested or executed through the web server.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
